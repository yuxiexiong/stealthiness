    "lines": [
      {
        "line": 586,
        "text": ""
      },
      {
        "line": 587,
        "text": "    def microbatch_loss_kind(self, step):"
      },
      {
        "line": 588,
        "text": "        return \"ce\""
      },
      {
        "line": 589,
        "text": ""
      },
      {
        "line": 590,
        "text": "    def keep_mask(self, step, row_indices, losses, hiddens):"
      },
      {
        "line": 591,
        "text": "        for detector in self.shadows.values():"
      },
      {
        "line": 592,
        "text": "            detector.observe(step, row_indices, losses)"
      },
      {
        "line": 593,
        "text": "        keep, reasons = [True] * len(row_indices), []"
      },
      {
        "line": 594,
        "text": "        if self.gate_open_step is None and losses:"
      },
      {
        "line": 595,
        "text": "            median = sorted(losses)[len(losses) // 2]"
      },
      {
        "line": 596,
        "text": "            if median < self.gate_median:"
      },
      {
        "line": 597,
        "text": "                self.gate_open_step = step"
      },
      {
        "line": 598,
        "text": "                self.events.append({\"kind\": \"cm_gate_open\", \"step\": step, \"step_median\": median})"
      },
      {
        "line": 599,
        "text": "        for i, (index, loss) in enumerate(zip(row_indices, losses)):"
      },
      {
        "line": 600,
        "text": "            group = self.groups.get(index, index)"
      },
      {
        "line": 601,
        "text": "            high = loss > self.threshold(group)"
      }
    ]
  },
