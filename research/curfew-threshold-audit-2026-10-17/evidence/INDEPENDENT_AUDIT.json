{
  "date": "2026-10-17",
  "role": "independent counterargument and fairness audit",
  "scope": {
    "read_only": true,
    "new_training": false,
    "new_inference": false,
    "new_evaluation": false,
    "code_changes": false,
    "new_papers": false
  },
  "conclusion_zh": "优先讨论正常高尾与阈值参照，预算列次位。cap或kept-only单项改变解释不了反转大头；floor直接保护正常行。分位护栏可能只是LT式混合，未获新贡献证据。",
  "evidence_levels": {
    "confirmed": [
      "Six-run exact recorded-decision reconstruction matches all saved mask tuples, loss values, gates and release counters.",
      "Real 96.265% of rows belong to groups of at most four rows, structurally unable to qualify for current pre-row four-history budget exemption.",
      "Same-gate development and saved same-gate real results rule out activation timing as the sole explanation.",
      "SQuAD Curfew has 123 scheduled steps without optimizer update, contradicting the earlier cost ledger blanket claim."
    ],
    "fixed_trace_accounting_only": [
      "No-cap, no-floor, no-budget and all-consumed contrasts change only each current decision while preserving actual losses and prior history/flags.",
      "Cap-attributable clean masks are 541/11/22 for real, versus 3415/1360/1547 actual clean masks.",
      "All-consumed instead of kept-only median changes only 11/1/4 real clean masks under this accounting."
    ],
    "hypotheses_not_causes": [
      "Group repetition/semantics may explain limited restoration opportunities, but regrouping or lowering history has no matched training effect evidence.",
      "Tokenizer, target, baseline knowledge and task difficulty can alter mean token CE distributions; answer length alone is not established as the cause.",
      "Kept-only selection feedback exists in implementation, but its propagated effect on endpoint ASR/quality is not isolated."
    ],
    "unknown": [
      "Retraining outcome after any threshold or budget change.",
      "Optimal safety/learning Pareto frontier over untested LT c values.",
      "Whether few masks improve useful new-knowledge learning.",
      "Historical immutable per-run source commit identity."
    ]
  },
  "rules": {
    "threshold": "T=min(1.5,max(.3,10*uppermedian(previous kept loss history))); no-history fallback1.5",
    "gate": "sticky; current16 uppermedian sorted[8]<.5; applies same step",
    "sequential": "after each kept row append to recent history; masked rows excluded; prune step window only after the16th row with s>step-20",
    "budget": "last<=10 high flags, len>=4 and high fraction>=.5 => high row exempt; require_known=False",
    "floor_binding": "10*median<.3; floor raises threshold, cannot itself add a mask under frozen history",
    "cap_binding": "max(.3,10*median)>1.5; binding alone is not a causal extra deletion",
    "cap_extra_mask": "gate open, not budget exempt, loss in(1.5,uncapped threshold] => actual mask but frozen-history no-cap keep",
    "floor_protection": "gate open, not budget exempt, loss in(no-floor threshold,.3] => actual keep but frozen-history no-floor mask",
    "reference_all_rows": "same historical time window and within-step prefix, but includes already consumed masked rows; uses actual fixed flags; a selection accounting contrast",
    "region_equality": "strict binding; ties exactly at .3/1.5 assigned middle, fallback separately"
  },
