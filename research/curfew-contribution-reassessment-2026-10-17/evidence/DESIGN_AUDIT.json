  "decisions": {
    "retain_observed": [
      "训练前向逐行loss可用于在线过滤，零新增模型前向。",
      "在现有toy的部分同seed合格比较中，Curfew删行明显少于固定LT；可保留为有条件工程现象。",
      "训练排程、阈值与后续更新会影响目标输出，已有失败轨迹需要一起保留。"
    ],
    "not_established": [
      "在线gate相对H20/H50的独立必要性。",
      "实体budget对frozen fx2成功或TOFU近A1的独立必要性。",
      "Curfew普遍比固定LT更少删干净行：real方向相反。",
      "把高loss叫作已证语义矛盾、把budget叫成只放行一条，均不准确。",
      "TOFU NLL接近A1不能替代LT-TOFU或无budget配对，也不能称98%问答准确率。"
    ],
    "can_simplify_in_claim": [
      "以固定预热LT为现有已成功的简单方案；不把线上gate/实体预算自动计作新增贡献。",
      "frozen require_known=False时，去掉论文叙述中的‘先确认实体已学会’解释；legacy group-known变量不是现行决策贡献。",
      "把few clean deletions与质量、风险、任务信息重复度一起报，不把删行数自动换算为知识保留或墙钟收益。"
    ],
    "hypotheses_only": [
      {
        "idea": "把自维持的group豁免改成真正有限放行或带冷却的恢复机制",
        "basis": "A1102预算入口与floor级联，现实现可连续释放高loss",
        "risk": "一条更新即可触发A级联，有限到1仍可能不足；限制恢复也可能重现实体/TOFU新知识饿死；当前未验证。"
      },
      {
        "idea": "针对触发后低loss级联讨论阈值地板与恢复更新间的相互作用",
        "basis": "A1102毒loss落到.27-.29低于.3",
        "risk": "降低floor可能大增clean mask与group豁免，不能从这条失败直接推更低更好；不得按毒标签/ASR真值在线决定。"
      },
      {
        "idea": "若保留数据代价为研究终点，应先确认应用本来重视哪类不可替代正常信息",
        "basis": "toy大量重复同32实体/128训练问法，少删行不等于少丢独立知识；real已有相反方向",
        "risk": "不能为挽救方法临时换目标或只挑toy优势。"
      }
    ],
    "discussion_order": "先确认相对固定LT还需要哪项真实价值，再讨论最少必要机制；当前不扩benchmark、不排实验，也不宣称假设修复已成功。"
  },
